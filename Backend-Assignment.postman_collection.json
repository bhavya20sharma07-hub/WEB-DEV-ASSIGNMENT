{
  "info": {
    "_postman_id": "8a61f6d0-30e6-4e0b-a8f5-2b1b6c4a2026",
    "name": "Node MongoDB Backend Assignment",
    "description": "Register/login, then use the returned JWT for protected post CRUD requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "postId", "value": "" }
  ],
  "item": [
    {
      "name": "Server",
      "item": [
        { "name": "Health Check", "request": { "method": "GET", "url": "{{baseUrl}}/" } }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "  pm.collectionVariables.set('token', pm.response.json().token);", "}"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo@example.com\",\n  \"password\": \"pass1234\"\n}" },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 200) {", "  pm.collectionVariables.set('token', pm.response.json().token);", "}"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"pass1234\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{baseUrl}}/api/auth/logout" }
        }
      ]
    },
    {
      "name": "Posts CRUD",
      "item": [
        {
          "name": "Create Post",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "  pm.collectionVariables.set('postId', pm.response.json().post._id);", "}"] } }],
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"My first post\",\n  \"content\": \"This post was created using my Express API.\"\n}" },
            "url": "{{baseUrl}}/api/posts"
          }
        },
        { "name": "Get All Posts", "request": { "method": "GET", "url": "{{baseUrl}}/api/posts" } },
        { "name": "Get Post By ID", "request": { "method": "GET", "url": "{{baseUrl}}/api/posts/{{postId}}" } },
        {
          "name": "Update Post",
          "request": {
            "method": "PUT",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated post title\",\n  \"content\": \"The post content has been updated.\"\n}" },
            "url": "{{baseUrl}}/api/posts/{{postId}}"
          }
        },
        {
          "name": "Delete Post",
          "request": { "method": "DELETE", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": "{{baseUrl}}/api/posts/{{postId}}" }
        }
      ]
    }
  ]
}
